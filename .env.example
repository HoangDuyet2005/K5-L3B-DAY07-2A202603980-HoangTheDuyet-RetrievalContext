# Copy to .env and fill in. Never commit .env.

# Gemini API key from Google AI Studio (agent model; see src/config.py).
GEMINI_API_KEY=

# Day 6 PostgreSQL + pgvector (local Docker Compose from the Day 6 repo; local-only credentials).
DATABASE_URL=postgresql://day6:day6_local_only@127.0.0.1:55433/day6_lab

# Optional overrides. Defaults live in src/config.py; traces record what was actually used.
# GEMINI_MODEL=gemini-3.5-flash
# EMBEDDING_DEVICE=cpu
